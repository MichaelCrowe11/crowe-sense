# Example /etc/crowe/node.toml. Written by `crowe-provision`; copy this only for dev.

node_id = "cs-a1b2c3"          # cs- plus six lowercase hex, assigned at provision
site = "north-grow-room"
zone = "tent-1"                # where this node's sensor head sits; the apps group by it
storage_mount = "/mnt/crowe"   # or /var/lib/crowe on a node without the drive bay
manifest_url = ""
private_key_path = "/etc/crowe/node.key"

[relay]
url = "https://sense.crowelogic.com"   # empty string = no cloud push, local API only

[api]
port = 8078

[sensors]
# The drivers this node runs, in order. A flow-hood node uses ["sdp810", "sht45", "pi"].
enabled = ["scd41", "sht45", "bme688", "veml7700", "pi"]

# Optional: push to your own bucket instead of the relay (only when [relay] url is "").
# [s3]
# bucket = "crowe-sense-telemetry"
# prefix = "raw"
# region = "us-east-1"
# endpoint_url = "https://minio.local"

[sampler.periods]
# Per-sensor cadence overrides (seconds). Defaults live in the driver.
# scd41    = 5.0
# sht45    = 1.0
# bme688   = 3.0
# veml7700 = 1.0
# sdp810   = 2.0
# pi       = 30.0
