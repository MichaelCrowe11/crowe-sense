+"""``crowe sense``: read a Crowe Sense node, directly or through the relay.
+
+The node and the relay serve one contract (crowe-sense/contracts/telemetry-v1.md):
+``/health``, ``/api/data``, ``/v1/latest``, ``/v1/history`` on the node, and the
+same reads under ``/v1/nodes/{node}`` on the relay behind a Crowe ID bearer.
+``endpoint()`` is the only place that difference lives.
+"""
+
+import json
+import os
+import sqlite3
+import subprocess
+import sys
+import tempfile
+import time
+import urllib.error
+import urllib.parse
+import urllib.request
+
+import click
+from rich import box
+from rich.table import Table
+
+from cli.console_io import console
+from cli.profile import command as _cmd
+
+DEFAULT_RELAY = "https://sense.crowelogic.com"
+CONFIG_ENV = "CROWE_SENSE_CONFIG"
+ANALYSIS_ENV = "CROWE_SENSE_ANALYSIS"
+DEFAULT_ANALYSIS = "~/crowe-sense/analysis/sense_check.py"
+TIMEOUT_S = 10.0
+CHECK_METRICS = ("temperature_c", "humidity_pct", "co2_ppm")
+BARS = "▁▂▃▄▅▆▇█"
+
+
+class SenseError(Exception):
+    """A failure the command reports in one line and exits 1 on."""
+
+
+# ── config ───────────────────────────────────────────────────────────────────
+
+
+def config_path() -> str:
+    return os.environ.get(CONFIG_ENV) or os.path.expanduser("~/.crowe-logic/sense.json")
+
+
+def load_config() -> dict:
+    try:
+        with open(config_path()) as f:
+            return json.load(f)
+    except (FileNotFoundError, json.JSONDecodeError):
+        return {}
+
+
+def save_config(cfg: dict) -> str:
+    path = config_path()
+    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
+    with open(path, "w") as f:
+        json.dump(cfg, f, indent=2)
+    return path
+
+
+def _no_node() -> SenseError:
+    c = _cmd()
+    return SenseError(
+        f"No node configured. Run `{c} sense use direct <url>` "
+        f"or `{c} sense use cloud <node-id>`."
+    )
+
+
+def endpoint(cfg: dict, path: str) -> str:
+    """Resolve a contract path against the configured source.
+
+    direct: ``<url><path>`` as written in the contract.
+    cloud:  ``<relay>/v1/nodes/<node><path minus a leading /v1>``, so
+    ``/v1/latest`` becomes ``/v1/nodes/cs-abc123/latest`` while ``/health`` and
+    ``/api/data`` keep their names.
+    """
+    source = cfg.get("source")
+    if source == "direct" and cfg.get("url"):
+        return cfg["url"].rstrip("/") + path
+    if source == "cloud" and cfg.get("node"):
+        relay = (cfg.get("relay") or DEFAULT_RELAY).rstrip("/")
+        tail = path[3:] if path.startswith("/v1/") else path
+        return f"{relay}/v1/nodes/{cfg['node']}{tail}"
+    raise _no_node()
+
+
+def relay_base(cfg: dict, relay: str | None) -> str:
+    return (relay or cfg.get("relay") or DEFAULT_RELAY).rstrip("/")
+
+
+# ── http ─────────────────────────────────────────────────────────────────────
+
+
+def bearer() -> str:
+    from cli import auth
+
+    try:
+        return auth.current_access_token()
+    except auth.NotLoggedIn:
+        raise SenseError(f"Not signed in to Crowe ID. Run `{_cmd()} login`.")
+
+
+def _request(url: str, token: str | None = None, body: dict | None = None) -> dict | list:
+    headers = {"accept": "application/json"}
+    data = None
+    if body is not None:
+        data = json.dumps(body).encode()
+        headers["content-type"] = "application/json"
+    if token:
+        headers["authorization"] = f"Bearer {token}"
+    req = urllib.request.Request(url, data=data, headers=headers, method="POST" if body is not None else "GET")
+    try:
+        with urllib.request.urlopen(req, timeout=TIMEOUT_S) as resp:
+            raw = resp.read()
+    except urllib.error.HTTPError as e:
+        raw = e.read()
+        try:
+            err = json.loads(raw)
+            detail = f"{err.get('error', e.code)}: {err.get('detail', '')}".rstrip(": ")
+        except (ValueError, AttributeError):
+            detail = f"{e.code} {e.reason}"
+        raise SenseError(f"{detail} ({url})")
+    except urllib.error.URLError as e:
+        raise SenseError(f"unreachable: {e.reason} ({url})")
+    except TimeoutError:
+        raise SenseError(f"unreachable: timed out after {TIMEOUT_S:.0f}s ({url})")
+    try:
+        return json.loads(raw)
+    except ValueError:
+        raise SenseError(f"not JSON from {url}")
+
+
+def fetch(cfg: dict, path: str) -> dict | list:
+    """A contract read against the configured source; cloud reads carry the bearer."""
+    url = endpoint(cfg, path)
+    token = bearer() if cfg.get("source") == "cloud" else None
+    return _request(url, token)
+
+
+# ── rendering ────────────────────────────────────────────────────────────────
+
+
+def _table(title: str, *cols: str) -> Table:
+    t = Table(title=title, box=box.SIMPLE_HEAD, border_style="#bfa669", title_style="bold #bfa669", padding=(0, 1))
+    for c in cols:
+        t.add_column(c)
+    return t
+
+
+def _age(seconds: float | None) -> str:
+    if seconds is None:
+        return "-"
+    seconds = max(0.0, float(seconds))
+    if seconds < 90:
+        return f"{seconds:.0f}s"
+    if seconds < 5400:
+        return f"{seconds / 60:.0f}m"
+    if seconds < 172800:
+        return f"{seconds / 3600:.1f}h"
+    return f"{seconds / 86400:.1f}d"
+
+
+def _num(v) -> str:
+    try:
+        v = float(v)
+    except (TypeError, ValueError):
+        return str(v)
+    return f"{v:,.0f}" if abs(v) >= 100 else f"{v:.2f}"
+
+
+def _stamp(ts: float) -> str:
+    return time.strftime("%Y-%m-%d %H:%M", time.localtime(float(ts)))
+
+
+def sparkline(values: list[float], width: int = 60) -> str:
+    """Plain block-character sparkline; downsampled by bucket mean to ``width``."""
+    vals = [float(v) for v in values if v is not None]
+    if not vals:
+        return ""
+    if len(vals) > width:
+        step = len(vals) / width
+        vals = [
+            sum(vals[int(i * step):max(int(i * step) + 1, int((i + 1) * step))])
+            / max(1, int((i + 1) * step) - int(i * step))
+            for i in range(width)
+        ]
+    lo, hi = min(vals), max(vals)
+    span = hi - lo
+    if span <= 0:
+        return BARS[3] * len(vals)
+    return "".join(BARS[min(7, int((v - lo) / span * 7.999))] for v in vals)
+
+
+def _fail(e: Exception) -> None:
+    console.print(f"  [bold red]{e}[/bold red]")
+    sys.exit(1)
+
+
+# ── commands ─────────────────────────────────────────────────────────────────
+
+
+@click.group(name="sense")
+def sense_cmd():
+    """The sensor node: live readings, history, pairing, and the practice check."""
+
+
+@sense_cmd.command(name="use")
+@click.argument("mode", type=click.Choice(["direct", "cloud"]))
+@click.argument("target")
+@click.option("--relay", default=None, help="Relay base URL for cloud mode.")
+def use_cmd(mode: str, target: str, relay: str | None):
+    """Point this machine at a node: `use direct http://host:8078` or `use cloud cs-a1b2c3`."""
+    cfg = load_config()
+    if mode == "direct":
+        if not target.startswith(("http://", "https://")):
+            _fail(SenseError("direct needs a URL such as http://100.123.229.57:8078"))
+        cfg.update({"source": "direct", "url": target.rstrip("/")})
+    else:
+        cfg.update({"source": "cloud", "node": target, "relay": relay_base(cfg, relay)})
+    path = save_config(cfg)
+    where = cfg["url"] if mode == "direct" else f"{cfg['node']} via {cfg['relay']}"
+    console.print(f"  Crowe Sense source: [#bfa669]{mode}[/#bfa669] {where}")
+    console.print(f"  [dim]saved to {path}[/dim]")
+
+
+@sense_cmd.command(name="status")
+def status_cmd():
+    """Is the node up? Reads /health; exits 1 when it is down or unreachable."""
+    cfg = load_config()
+    try:
+        h = fetch(cfg, "/health")
+    except SenseError as e:
+        _fail(e)
+    ok = bool(h.get("ok"))
+    t = _table("Crowe Sense", "Field", "Value")
+    t.add_row("node", str(h.get("node", "-")))
+    t.add_row("zone", str(h.get("zone", "-")))
+    t.add_row("readings", _num(h.get("readings", 0)))
+    t.add_row("last reading", _age(h.get("age_s")) + " ago" if h.get("age_s") is not None else "-")
+    t.add_row("uptime", _age(h.get("uptime_s")))
+    t.add_row("version", str(h.get("version", "-")))
+    t.add_row("state", "[#8fbf8f]ok[/#8fbf8f]" if ok else "[bold red]down[/bold red]")
+    console.print(t)
+    if not ok:
+        sys.exit(1)
+
+
+@sense_cmd.command(name="latest")
+def latest_cmd():
+    """The newest reading of every zone and metric."""
+    cfg = load_config()
+    try:
+        rows = fetch(cfg, "/v1/latest")
+    except SenseError as e:
+        _fail(e)
+    if not isinstance(rows, list) or not rows:
+        console.print("  no readings yet")
+        return
+    now = time.time()
+    zones: dict[str, list[dict]] = {}
+    for r in rows:
+        zones.setdefault(str(r.get("zone", "?")), []).append(r)
+    for zone in sorted(zones):
+        t = _table(zone, "Metric", "Value", "Unit", "Quality", "Age")
+        for r in sorted(zones[zone], key=lambda x: str(x.get("metric"))):
+            t.add_row(
+                str(r.get("metric")),
+                _num(r.get("value")),
+                str(r.get("unit", "")),
+                str(r.get("quality", "ok")),
+                _age(now - float(r.get("ts", now))),
+            )
+        console.print(t)
+
+
+@sense_cmd.command(name="history")
+@click.option("--metric", default="co2_ppm", show_default=True)
+@click.option("--zone", default=None, help="Zone label; the node default when omitted.")
+@click.option("--hours", default=24.0, show_default=True, type=float)
+@click.option("--step", default=300, show_default=True, type=int, help="Bucket width in seconds.")
+def history_cmd(metric: str, zone: str | None, hours: float, step: int):
+    """One metric over a window: min, mean, max and a sparkline."""
+    cfg = load_config()
+    q = {"metric": metric, "hours": hours, "step": step}
+    if zone:
+        q["zone"] = zone
+    try:
+        h = fetch(cfg, "/v1/history?" + urllib.parse.urlencode(q))
+    except SenseError as e:
+        _fail(e)
+    points = [p for p in h.get("points", []) if p and p[1] is not None]
+    unit = h.get("unit", "")
+    label = f"{h.get('zone') or zone or ''} {h.get('metric', metric)}".strip()
+    if not points:
+        console.print(f"  {label}: no points in the last {hours:g}h")
+        return
+    vals = [float(p[1]) for p in points]
+    console.print(f"  [#bfa669]{label}[/#bfa669]  {len(points)} points, {hours:g}h, step {step}s")
+    console.print(f"  min {_num(min(vals))}  mean {_num(sum(vals) / len(vals))}  max {_num(max(vals))} {unit}")
+    console.print(f"  {sparkline(vals)}")
+    console.print(f"  [dim]{_stamp(points[0][0])} to {_stamp(points[-1][0])}[/dim]")
+
+
+@sense_cmd.command(name="nodes")
+@click.option("--relay", default=None, help="Relay base URL.")
+def nodes_cmd(relay: str | None):
+    """The nodes paired to this Crowe ID, from the relay."""
+    cfg = load_config()
+    try:
+        rows = _request(f"{relay_base(cfg, relay)}/v1/nodes", bearer())
+    except SenseError as e:
+        _fail(e)
+    if not rows:
+        console.print(f"  No nodes paired. Pair one with `{_cmd()} sense pair <node> <public-key>`.")
+        return
+    now = time.time()
+    t = _table("Paired nodes", "Node", "Zone", "Label", "Last seen")
+    for r in rows:
+        seen = r.get("last_seen_ts")
+        t.add_row(str(r.get("node") or r.get("node_id")), str(r.get("zone", "")), str(r.get("label", "")), (_age(now - float(seen)) + " ago") if seen else "never")
+    console.print(t)
+
+
+@sense_cmd.command(name="pair")
+@click.argument("node")
+@click.argument("public_key")
+@click.option("--zone", required=True, help="Where the sensor head sits, e.g. tent-1.")
+@click.option("--label", default="", help="A name for people, e.g. North tent.")
+@click.option("--relay", default=None, help="Relay base URL.")
+def pair_cmd(node: str, public_key: str, zone: str, label: str, relay: str | None):
+    """Register a node's public key to this Crowe ID on the relay."""
+    cfg = load_config()
+    body = {"node": node, "public_key": public_key, "zone": zone, "label": label}
+    try:
+        out = _request(f"{relay_base(cfg, relay)}/v1/nodes", bearer(), body)
+    except SenseError as e:
+        _fail(e)
+    console.print(f"  paired [#bfa669]{out.get('node', node)}[/#bfa669] as {zone}" + (f" ({label})" if label else ""))
+    if cfg.get("source") != "cloud":
+        console.print(f"  [dim]read it with `{_cmd()} sense use cloud {node}`[/dim]")
+
+
+def build_check_db(cfg: dict, hours: float, zones: list[str], step: int = 60) -> tuple[str, int]:
+    """Pull the check metrics for each zone into a SQLite file sense_check.py can read."""
+    fd, path = tempfile.mkstemp(prefix="crowe-sense-", suffix=".db")
+    os.close(fd)
+    con = sqlite3.connect(path)
+    con.execute("CREATE TABLE readings (epoch REAL, metric TEXT, value REAL, sensor TEXT)")
+    written = 0
+    for zone in zones:
+        for metric in CHECK_METRICS:
+            q = urllib.parse.urlencode({"metric": metric, "zone": zone, "hours": hours, "step": step})
+            h = fetch(cfg, "/v1/history?" + q)
+            rows = [(float(p[0]), metric, float(p[1]), zone) for p in h.get("points", []) if p and p[1] is not None]
+            con.executemany("INSERT INTO readings VALUES (?,?,?,?)", rows)
+            written += len(rows)
+    con.commit()
+    con.close()
+    return path, written
+
+
+@sense_cmd.command(name="check")
+@click.option("--hours", default=72.0, show_default=True, type=float)
+@click.option("--zone", "only_zone", default=None, help="Check one zone instead of every zone the node reports.")
+@click.option("--stage", default=None, help="Override the stage log (passed through to sense_check.py).")
+def check_cmd(hours: float, only_zone: str | None, stage: str | None):
+    """Judge the last window against documented practice (needs the analysis checkout)."""
+    script = os.path.expanduser(os.environ.get(ANALYSIS_ENV) or DEFAULT_ANALYSIS)
+    if not os.path.exists(script):
+        console.print(f"  The practice check lives in the crowe-sense analysis package, expected at {script}.")
+        console.print("  Clone github.com/MichaelCrowe11/crowe-sense and run this again.")
+        sys.exit(2)
+    cfg = load_config()
+    try:
+        latest = fetch(cfg, "/v1/latest")
+        zones = sorted({str(r.get("zone")) for r in latest if r.get("zone")})
+        if only_zone:
+            zones = [only_zone]
+        if not zones:
+            raise SenseError("the node reports no zones yet")
+        db, n = build_check_db(cfg, hours, zones)
+    except SenseError as e:
+        _fail(e)
+    console.print(f"  [dim]{n} points for {', '.join(zones)} in {db}[/dim]")
+    worst = 0
+    for zone in zones:
+        argv = [sys.executable, script, "--db", db, "--hours", str(hours), "--zone", zone]
+        if stage:
+            argv += ["--stage", stage]
+        # Captured rather than inherited so the report lands in the same stream
+        # as the rest of the command (and in CliRunner's output under test).
+        res = subprocess.run(argv, cwd=os.path.dirname(script), capture_output=True, text=True)
+        if res.stdout:
+            click.echo(res.stdout.rstrip("\n"))
+        if res.stderr:
+            click.echo(res.stderr.rstrip("\n"), err=True)
+        worst = max(worst, res.returncode)
+    sys.exit(worst)
