+"""``crowe sense`` against a stub node and a stub relay speaking telemetry v1."""
+
+import json
+import os
+import sqlite3
+import threading
+import time
+from http.server import BaseHTTPRequestHandler, HTTPServer
+from urllib.parse import parse_qs, urlparse
+
+import pytest
+from click.testing import CliRunner
+
+from cli.commands import sense
+from cli.commands.sense import endpoint, sense_cmd, sparkline
+
+NOW = time.time()
+
+
+def _health(ok=True):
+    return {"ok": ok, "node": "cs-a1b2c3", "zone": "tent-1", "readings": 5048780,
+            "last_ts": NOW - 4.2, "age_s": 4.2 if ok else 900.0, "uptime_s": 86400, "version": "0.2.0"}
+
+
+LATEST = [
+    {"ts": NOW - 5, "node": "cs-a1b2c3", "zone": "tent-1", "sensor": "scd41", "metric": "co2_ppm", "value": 812.0, "unit": "ppm", "quality": "ok"},
+    {"ts": NOW - 5, "node": "cs-a1b2c3", "zone": "tent-1", "sensor": "sht45", "metric": "temperature_c", "value": 21.37, "unit": "C", "quality": "ok"},
+    {"ts": NOW - 5, "node": "cs-a1b2c3", "zone": "tent-1", "sensor": "sht45", "metric": "humidity_pct", "value": 88.1, "unit": "%", "quality": "ok"},
+    {"ts": NOW - 5, "node": "cs-a1b2c3", "zone": "hood-1", "sensor": "sdp810", "metric": "prefilter_dp_pa", "value": 41.0, "unit": "Pa", "quality": "ok"},
+]
+
+
+def _history(q):
+    metric = q.get("metric", ["co2_ppm"])[0]
+    zone = q.get("zone", ["tent-1"])[0]
+    pts = [[NOW - 3600 + i * 300, 700.0 + (i % 5) * 40] for i in range(12)]
+    return {"metric": metric, "zone": zone, "unit": "ppm", "points": pts}
+
+
+class Stub:
+    """One server that answers as a node (direct paths) and as a relay (per-node paths)."""
+
+    def __init__(self, ok=True):
+        self.ok = ok
+        self.seen = []
+        self.nodes = []
+        outer = self
+
+        class H(BaseHTTPRequestHandler):
+            def log_message(self, *a):
+                pass
+
+            def _send(self, code, body):
+                raw = json.dumps(body).encode()
+                self.send_response(code)
+                self.send_header("content-type", "application/json")
+                self.send_header("content-length", str(len(raw)))
+                self.end_headers()
+                self.wfile.write(raw)
+
+            def do_GET(self):
+                u = urlparse(self.path)
+                q = parse_qs(u.query)
+                outer.seen.append((self.command, u.path, {k.lower(): v for k, v in self.headers.items()}))
+                p = u.path
+                if p.startswith("/v1/nodes/cs-a1b2c3/"):
+                    p = p[len("/v1/nodes/cs-a1b2c3"):]
+                    if p in ("/latest", "/history"):
+                        p = "/v1" + p
+                    if "authorization" not in self.headers:
+                        return self._send(401, {"error": "unauthorized", "detail": "bearer required"})
+                if p == "/health":
+                    return self._send(200, _health(outer.ok))
+                if p == "/v1/latest":
+                    return self._send(200, LATEST)
+                if p == "/v1/history":
+                    return self._send(200, _history(q))
+                if p == "/v1/nodes":
+                    if "authorization" not in self.headers:
+                        return self._send(401, {"error": "unauthorized", "detail": "bearer required"})
+                    return self._send(200, outer.nodes)
+                self._send(404, {"error": "not_found", "detail": p})
+
+            def do_POST(self):
+                n = int(self.headers.get("content-length", 0))
+                body = json.loads(self.rfile.read(n) or b"{}")
+                outer.seen.append((self.command, self.path, {k.lower(): v for k, v in self.headers.items()}, body))
+                if "authorization" not in self.headers:
+                    return self._send(401, {"error": "unauthorized", "detail": "bearer required"})
+                if self.path == "/v1/nodes":
+                    outer.nodes.append({"node": body["node"], "zone": body["zone"], "label": body.get("label", ""), "last_seen_ts": None})
+                    return self._send(201, {"node": body["node"]})
+                self._send(404, {"error": "not_found", "detail": self.path})
+
+        self.srv = HTTPServer(("127.0.0.1", 0), H)
+        self.url = f"http://127.0.0.1:{self.srv.server_port}"
+        threading.Thread(target=self.srv.serve_forever, daemon=True).start()
+
+    def close(self):
+        self.srv.shutdown()
+
