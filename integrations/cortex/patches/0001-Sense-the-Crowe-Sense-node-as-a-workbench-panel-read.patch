@@ -0,0 +1,185 @@
+// @vitest-environment happy-dom
+import { fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+vi.mock("../csep/auth", () => ({
+  useAuth: { getState: () => ({ accessToken: async () => null }) },
+}));
+
+import { SenseTab } from "./SenseTab";
+import { DEFAULT_RELAY, senseEndpoint, type SenseConfig } from "../config/sense";
+
+function installStorage(seed: Record<string, string> = {}) {
+  const store = new Map<string, string>(Object.entries(seed));
+  Object.defineProperty(window, "localStorage", {
+    configurable: true,
+    value: {
+      getItem: (key: string) => store.get(key) ?? null,
+      setItem: (key: string, value: string) => store.set(key, value),
+      removeItem: (key: string) => store.delete(key),
+      clear: () => store.clear(),
+    },
+  });
+  return store;
+}
+
+const T0 = 1_756_700_000;
+const series = (base: number, step: number): [number, number][] =>
+  Array.from({ length: 12 }, (_, i) => [T0 - (11 - i) * 1800, base + i * step]);
+
+/* Contract-shaped GET /api/data?hours=6 payload (telemetry-v1.md). */
+const payload = {
+  generated: T0,
+  node: "cs-a1b2c3",
+  count: 5048780,
+  hours: 6,
+  snapshot: {
+    "tent-1": {
+      temperature_c: { value: 21.04, unit: "C", quality: "ok", age: 4.2 },
+      humidity_pct: { value: 85.1, unit: "%", quality: "ok", age: 4.2 },
+      co2_ppm: { value: 812, unit: "ppm", quality: "ok", age: 5.0 },
+      light_lux: { value: 320, unit: "lux", quality: "ok", age: 4.0 },
+    },
+    "tent-1-derived": {
+      vpd_kpa: { value: 0.37, unit: "kPa", quality: "est", age: 4.2 },
+      dew_point_c: { value: 18.3, unit: "C", quality: "est", age: 4.2 },
+      fruiting_score: { value: 88.4, unit: "", quality: "est", age: 4.2 },
+    },
+    "hood-1": {
+      prefilter_dp_pa: { value: 41, unit: "Pa", quality: "ok", age: 6 },
+    },
+    "hood-1-derived": {
+      hood_face_velocity_fpm: { value: 102, unit: "fpm", quality: "est", age: 6 },
+      hood_laminar_ok: { value: 1, unit: "", quality: "est", age: 6 },
+    },
+    pi: {
+      soc_temp_c: { value: 48.7, unit: "C", quality: "ok", age: 3 },
+      undervoltage_now: { value: 0, unit: "", quality: "ok", age: 3 },
+    },
+  },
+  series: {
+    "tent-1|temperature_c": series(20.2, 0.08),
+    "tent-1|humidity_pct": series(88, -0.3),
+    "tent-1|co2_ppm": series(700, 10),
+  },
+};
+
+function okJson(body: unknown) {
+  return new Response(JSON.stringify(body), { status: 200, headers: { "content-type": "application/json" } });
+}
+
+describe("SenseTab", () => {
+  beforeEach(() => {
+    vi.restoreAllMocks();
+  });
+
+  it("renders tiles, derived metrics, sparklines, hood and controller from a direct node", async () => {
+    installStorage({ "crowe-sense-source": "direct", "crowe-sense-url": "http://node.test:8078" });
+    const fetchMock = vi.fn(async (_input: RequestInfo | URL, _init?: RequestInit) => okJson(payload));
+    vi.stubGlobal("fetch", fetchMock);
+
+    const { container } = render(<SenseTab />);
+
+    await screen.findByText("Temperature");
+    expect(fetchMock).toHaveBeenCalledTimes(1);
+    expect(String(fetchMock.mock.calls[0][0])).toBe("http://node.test:8078/api/data?hours=6");
+
+    expect(screen.getByText("812")).toBeInTheDocument();
+    expect(screen.getByText("85.10")).toBeInTheDocument();
+    expect(screen.getByText("0.37")).toBeInTheDocument();
+    expect(screen.getByText("88.40")).toBeInTheDocument();
+    expect(container.querySelector('.cx-sense-score[data-band="good"]')).not.toBeNull();
+
+    const sparks = container.querySelectorAll("svg.cx-sense-spark");
+    expect(sparks.length).toBe(3);
+    expect(container.querySelector(".cx-sense-spark-line")?.getAttribute("d")).toMatch(/^M/);
+
+    expect(screen.getByRole("region", { name: "Flow hood" })).toBeInTheDocument();
+    expect(screen.getByText("Laminar flow")).toBeInTheDocument();
+    expect(screen.getByRole("region", { name: "Controller" })).toBeInTheDocument();
+    expect(screen.getByText("cs-a1b2c3")).toBeInTheDocument();
+    expect(screen.getByText(/5,048,780 readings/)).toBeInTheDocument();
+    expect(screen.getByText(/updated/)).toBeInTheDocument();
+    expect(container.querySelector('.cx-sense-dot[data-status="ok"]')).not.toBeNull();
+  });
+
+  it("shows the empty state and never fetches when the source is off", () => {
+    installStorage();
+    const fetchMock = vi.fn();
+    vi.stubGlobal("fetch", fetchMock);
+
+    render(<SenseTab />);
+
+    expect(screen.getByText("No node paired.")).toBeInTheDocument();
+    expect(screen.getByText(/Choose direct for a node on your network or cloud for a relay node/)).toBeInTheDocument();
+    expect(fetchMock).not.toHaveBeenCalled();
+  });
+
+  it("shows the error state with the failure detail when the node cannot be reached", async () => {
+    installStorage({ "crowe-sense-source": "direct", "crowe-sense-url": "http://node.test:8078" });
+    vi.stubGlobal("fetch", vi.fn(async () => { throw new TypeError("Failed to fetch"); }));
+
+    render(<SenseTab />);
+
+    const alert = await screen.findByRole("alert");
+    expect(alert).toHaveTextContent("Cannot read the node (unreachable).");
+    expect(alert).toHaveTextContent("cannot reach http://node.test:8078/api/data?hours=6: Failed to fetch");
+  });
+
+  it("surfaces the contract error pair from a non-2xx answer", async () => {
+    installStorage({ "crowe-sense-source": "direct", "crowe-sense-url": "http://node.test:8078" });
+    vi.stubGlobal(
+      "fetch",
+      vi.fn(async () => new Response(JSON.stringify({ error: "not_found", detail: "no such node" }), { status: 404 })),
+    );
+
+    render(<SenseTab />);
+
+    const alert = await screen.findByRole("alert");
+    expect(alert).toHaveTextContent("not_found");
+    expect(alert).toHaveTextContent("no such node");
+  });
+
+  it("saves a new source and refetches against it", async () => {
+    const store = installStorage();
+    const fetchMock = vi.fn(async (_input: RequestInfo | URL, _init?: RequestInit) => okJson(payload));
+    vi.stubGlobal("fetch", fetchMock);
+
+    render(<SenseTab />);
+    fireEvent.change(screen.getByLabelText("Source"), { target: { value: "direct" } });
+    fireEvent.change(screen.getByLabelText("Node address"), { target: { value: "http://10.0.0.9:8078/" } });
+    fireEvent.click(screen.getByRole("button", { name: "Save" }));
+
+    await waitFor(() => expect(fetchMock).toHaveBeenCalled());
+    expect(String(fetchMock.mock.calls[0][0])).toBe("http://10.0.0.9:8078/api/data?hours=6");
+    expect(store.get("crowe-sense-source")).toBe("direct");
+    expect(store.get("crowe-sense-url")).toBe("http://10.0.0.9:8078/");
+  });
+});
+
+describe("senseEndpoint", () => {
+  const base: SenseConfig = { source: "off", url: "", node: "", relay: DEFAULT_RELAY };
+
+  it("direct mode appends the contract path to the node address", () => {
+    const cfg = { ...base, source: "direct" as const, url: "http://100.123.229.57:8078/" };
+    expect(senseEndpoint(cfg, "/health")).toBe("http://100.123.229.57:8078/health");
+    expect(senseEndpoint(cfg, "/api/data?hours=6")).toBe("http://100.123.229.57:8078/api/data?hours=6");
+    expect(senseEndpoint(cfg, "/v1/latest")).toBe("http://100.123.229.57:8078/v1/latest");
+  });
+
+  it("cloud mode mounts per-node reads under the relay and strips the /v1 prefix", () => {
+    const cfg = { ...base, source: "cloud" as const, node: "cs-a1b2c3" };
+    expect(senseEndpoint(cfg, "/health")).toBe("https://sense.crowelogic.com/v1/nodes/cs-a1b2c3/health");
+    expect(senseEndpoint(cfg, "/api/data?hours=6")).toBe("https://sense.crowelogic.com/v1/nodes/cs-a1b2c3/api/data?hours=6");
+    expect(senseEndpoint(cfg, "/v1/latest")).toBe("https://sense.crowelogic.com/v1/nodes/cs-a1b2c3/latest");
+    expect(senseEndpoint(cfg, "/v1/history?metric=co2_ppm&zone=tent-1")).toBe(
+      "https://sense.crowelogic.com/v1/nodes/cs-a1b2c3/history?metric=co2_ppm&zone=tent-1",
+    );
+  });
+
+  it("refuses to build a URL it cannot stand behind", () => {
+    expect(() => senseEndpoint(base, "/health")).toThrow(/no node paired/);
+    expect(() => senseEndpoint({ ...base, source: "cloud", node: "raspberrypi" }, "/health")).toThrow(/cs-a1b2c3/);
+    expect(() => senseEndpoint({ ...base, source: "direct", url: "  " }, "/health")).toThrow(/node address/);
+  });
+});
