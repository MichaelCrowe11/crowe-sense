diff --git a/src/lib/sense-client.ts b/src/lib/sense-client.ts
new file mode 100644
index 0000000..00597fb
--- /dev/null
+++ b/src/lib/sense-client.ts
@@ -0,0 +1,171 @@
+/* Typed reads of the Crowe Sense telemetry contract v1.
+ *
+ * Every function resolves the configured source (config/sense.ts), applies a
+ * 10 s timeout, sends the Crowe ID bearer in cloud mode, and turns any failure
+ * into a SenseRequestError carrying the contract's `{error, detail}` pair so
+ * the surface can print the detail instead of a stack trace.
+ */
+import { getSenseConfig, getSenseToken, senseEndpoint, type SenseConfig } from "../config/sense";
+
+export interface SenseHealth {
+  ok: boolean;
+  node: string;
+  zone?: string;
+  readings: number;
+  last_ts: number | null;
+  age_s: number | null;
+  uptime_s?: number;
+  version?: string;
+}
+
+export interface SnapshotEntry {
+  value: number;
+  unit: string;
+  quality: string;
+  age: number;
+}
+
+/** GET /api/data: newest reading per zone and metric, plus 6 h series. */
+export interface SenseData {
+  generated: number;
+  node: string;
+  count: number;
+  hours: number;
+  snapshot: Record<string, Record<string, SnapshotEntry>>;
+  series: Record<string, [number, number][]>;
+}
+
+export interface SenseReading {
+  ts: number;
+  node: string;
+  zone: string;
+  sensor: string;
+  metric: string;
+  value: number;
+  unit: string;
+  quality?: string;
+}
+
+export interface SenseHistory {
+  metric: string;
+  zone: string;
+  unit: string;
+  points: [number, number][];
+}
+
+export class SenseRequestError extends Error {
+  readonly error: string;
+  readonly detail: string;
+  readonly status: number;
+  constructor(error: string, detail: string, status = 0) {
+    super(`${error}: ${detail}`);
+    this.name = "SenseRequestError";
+    this.error = error;
+    this.detail = detail;
+    this.status = status;
+  }
+}
+
+export interface ClientOptions {
+  cfg?: SenseConfig;
+  /** Crowe ID access token supplier for cloud mode. */
+  getToken?: () => Promise<string | null>;
+  timeoutMs?: number;
+  fetchImpl?: typeof fetch;
+}
+
+const DEFAULT_TIMEOUT_MS = 10_000;
+
+async function bearer(cfg: SenseConfig, opts: ClientOptions): Promise<string | null> {
+  if (cfg.source !== "cloud") return null;
+  if (opts.getToken) {
+    try {
+      const t = await opts.getToken();
+      if (t) return t;
+    } catch {
+      /* fall through to the manual token */
+    }
+  }
+  const manual = getSenseToken();
+  return manual || null;
+}
+
+async function request<T>(path: string, opts: ClientOptions = {}): Promise<T> {
+  const cfg = opts.cfg ?? getSenseConfig();
+  let url: string;
+  try {
+    url = senseEndpoint(cfg, path);
+  } catch (e) {
+    throw new SenseRequestError("unconfigured", e instanceof Error ? e.message : String(e));
+  }
+  const headers: Record<string, string> = { accept: "application/json" };
+  const token = await bearer(cfg, opts);
+  if (token) headers.authorization = `Bearer ${token}`;
+  else if (cfg.source === "cloud") {
+    throw new SenseRequestError("unauthorized", "cloud mode needs a Crowe ID sign-in or a pasted token");
+  }
+
+  const ctl = new AbortController();
+  const timer = setTimeout(() => ctl.abort(), opts.timeoutMs ?? DEFAULT_TIMEOUT_MS);
+  const doFetch = opts.fetchImpl ?? fetch;
+  let res: Response;
+  try {
+    res = await doFetch(url, { headers, signal: ctl.signal });
+  } catch (e) {
+    clearTimeout(timer);
+    const aborted = e instanceof Error && e.name === "AbortError";
+    throw new SenseRequestError(
+      aborted ? "timeout" : "unreachable",
+      aborted ? `no answer from ${url} within ${(opts.timeoutMs ?? DEFAULT_TIMEOUT_MS) / 1000} s` : `cannot reach ${url}: ${e instanceof Error ? e.message : String(e)}`,
+    );
+  }
+  clearTimeout(timer);
+
+  if (!res.ok) {
+    let error = `http_${res.status}`;
+    let detail = res.statusText || `status ${res.status}`;
+    try {
+      const body = (await res.json()) as Partial<{ error: string; detail: string }>;
+      if (body && typeof body.error === "string") error = body.error;
+      if (body && typeof body.detail === "string") detail = body.detail;
+    } catch {
+      /* non-JSON error body: keep the status text */
+    }
+    throw new SenseRequestError(error, detail, res.status);
+  }
+  try {
+    return (await res.json()) as T;
+  } catch {
+    throw new SenseRequestError("bad_response", `${url} did not return JSON`, res.status);
+  }
+}
+
+export function fetchHealth(opts?: ClientOptions): Promise<SenseHealth> {
+  return request<SenseHealth>("/health", opts);
+}
+
+export function fetchData(hours = 6, opts?: ClientOptions): Promise<SenseData> {
+  const h = Number.isFinite(hours) && hours > 0 ? hours : 6;
+  return request<SenseData>(`/api/data?hours=${h}`, opts);
+}
+
+export function fetchLatest(opts?: ClientOptions): Promise<SenseReading[]> {
+  return request<SenseReading[]>("/v1/latest", opts);
+}
+
+export function fetchHistory(
+  q: { metric: string; zone: string; hours?: number; step?: number },
+  opts?: ClientOptions,
+): Promise<SenseHistory> {
+  const params = new URLSearchParams({ metric: q.metric, zone: q.zone });
+  if (q.hours) params.set("hours", String(q.hours));
+  if (q.step) params.set("step", String(q.step));
+  return request<SenseHistory>(`/v1/history?${params.toString()}`, opts);
+}
+
+/** Text a surface can print for any failure, contract-shaped or not. */
+export function describeSenseError(e: unknown): { error: string; detail: string } {
+  if (e instanceof SenseRequestError) return { error: e.error, detail: e.detail };
+  if (e instanceof Error) return { error: "error", detail: e.message };
+  return { error: "error", detail: String(e) };
+}
