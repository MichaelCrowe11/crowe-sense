diff --git a/src/config/sense.ts b/src/config/sense.ts
new file mode 100644
index 0000000..cde100c
--- /dev/null
+++ b/src/config/sense.ts
@@ -0,0 +1,114 @@
+/* Crowe Sense node configuration for Cortex.
+ *
+ * Mirrors config/farm.ts: a handful of localStorage keys, read on demand, no
+ * store. Two ways to reach a node, both speaking the same contract
+ * (crowe-sense/contracts/telemetry-v1.md):
+ *
+ *   direct  the node's own API on the operator's network or tailnet,
+ *           `http://<node>:8078`, no auth.
+ *   cloud   the relay, `https://sense.crowelogic.com/v1/nodes/<node>`, with the
+ *           operator's Crowe ID bearer.
+ *
+ * `off` is the honest default: the tab shows nothing rather than a demo.
+ * Tokens never live here; cloud mode borrows the Crowe ID access token from
+ * csep/auth at request time, with `crowe-sense-token` as a manual fallback for
+ * an operator who pastes one.
+ */
+
+export type SenseSource = "off" | "direct" | "cloud";
+
+export interface SenseConfig {
+  source: SenseSource;
+  /** Direct mode: base URL of the node API, e.g. http://100.123.229.57:8078 */
+  url: string;
+  /** Cloud mode: node id, e.g. cs-a1b2c3 */
+  node: string;
+  /** Cloud mode: relay base URL */
+  relay: string;
+}
+
+export const DEFAULT_RELAY = "https://sense.crowelogic.com";
+export const DEFAULT_DIRECT_URL = "http://crowe-sense.local:8078";
+
+const KEY_SOURCE = "crowe-sense-source";
+const KEY_URL = "crowe-sense-url";
+const KEY_NODE = "crowe-sense-node";
+const KEY_RELAY = "crowe-sense-relay";
+const KEY_TOKEN = "crowe-sense-token";
+
+function read(key: string, fallback: string): string {
+  try {
+    const v = localStorage.getItem(key);
+    return v === null ? fallback : v;
+  } catch {
+    return fallback;
+  }
+}
+
+function write(key: string, value: string): void {
+  try {
+    if (value === "") localStorage.removeItem(key);
+    else localStorage.setItem(key, value);
+  } catch {
+    /* storage unavailable: config is session-only */
+  }
+}
+
+function asSource(raw: string): SenseSource {
+  return raw === "direct" || raw === "cloud" ? raw : "off";
+}
+
+export function getSenseConfig(): SenseConfig {
+  return {
+    source: asSource(read(KEY_SOURCE, "off")),
+    url: read(KEY_URL, DEFAULT_DIRECT_URL),
+    node: read(KEY_NODE, ""),
+    relay: read(KEY_RELAY, DEFAULT_RELAY),
+  };
+}
+
+export function setSenseConfig(patch: Partial<SenseConfig>): SenseConfig {
+  const next = { ...getSenseConfig(), ...patch };
+  write(KEY_SOURCE, next.source);
+  write(KEY_URL, next.url.trim());
+  write(KEY_NODE, next.node.trim());
+  write(KEY_RELAY, next.relay.trim());
+  return getSenseConfig();
+}
+
+/** Manual bearer for cloud mode when no Crowe ID session is signed in. */
+export function getSenseToken(): string {
+  return read(KEY_TOKEN, "");
+}
+
+export function setSenseToken(token: string): void {
+  write(KEY_TOKEN, token.trim());
+}
+
+function stripSlash(base: string): string {
+  return base.trim().replace(/\/+$/, "");
+}
+
+/** Resolve a contract path against the configured source.
+ *
+ * Contract paths are what the node serves: `/health`, `/api/data?hours=6`,
+ * `/v1/latest`, `/v1/history?...`. The relay mounts the same reads under
+ * `/v1/nodes/<node>` without the `/v1` prefix, so `/v1/latest` becomes
+ * `/v1/nodes/<node>/latest` and `/api/data` stays `/api/data`.
+ */
+export function senseEndpoint(cfg: SenseConfig, path: string): string {
+  const p = path.startsWith("/") ? path : `/${path}`;
+  if (cfg.source === "direct") {
+    const base = stripSlash(cfg.url);
+    if (!base) throw new Error("direct mode needs the node address");
+    return `${base}${p}`;
+  }
+  if (cfg.source === "cloud") {
+    const relay = stripSlash(cfg.relay || DEFAULT_RELAY);
+    const node = cfg.node.trim();
+    if (!/^cs-[0-9a-f]{6}$/.test(node)) throw new Error("cloud mode needs a node id like cs-a1b2c3");
+    const rel = p.startsWith("/v1/") ? p.slice(3) : p;
+    return `${relay}/v1/nodes/${node}${rel}`;
+  }
+  throw new Error("no node paired");
+}
