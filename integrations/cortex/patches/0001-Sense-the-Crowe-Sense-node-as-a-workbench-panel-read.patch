+/* Sense: the Crowe Sense node, read live.
+ *
+ * Same discipline as CockpitTelemetry: every number on this surface came off
+ * the node within the last refresh, or the surface says why it did not. There
+ * is no sample data, no placeholder reading, and an unpaired node shows an
+ * empty state rather than a demo. The read contract is
+ * crowe-sense/contracts/telemetry-v1.md; the shape rendered here is
+ * `GET /api/data?hours=6`, served identically by the node and the relay.
+ */
+import { useCallback, useEffect, useMemo, useState, type ReactElement } from "react";
+import {
+  getSenseConfig,
+  getSenseToken,
+  setSenseConfig,
+  setSenseToken,
+  type SenseConfig,
+  type SenseSource,
+} from "../config/sense";
+import { describeSenseError, fetchData, type SenseData, type SnapshotEntry } from "../lib/sense-client";
+import { useAuth } from "../csep/auth";
+import { EmptyState, ErrorState, LoadingState } from "./StateSurface";
+import "./SenseTab.css";
+
+const REFRESH_MS = 15_000;
+const CLOCK_MS = 5_000;
+/** A reading older than this is not "live"; the header dot goes down. */
+const STALE_S = 180;
+
+const LABELS: Record<string, string> = {
+  temperature_c: "Temperature",
+  humidity_pct: "Humidity",
+  co2_ppm: "CO2",
+  vpd_kpa: "VPD",
+  dew_point_c: "Dew point",
+  light_lux: "Light",
+  fruiting_score: "Fruiting score",
+  co2_trend_ppm_min: "CO2 trend",
+  gas_ohms: "Gas resistance",
+  pressure_hpa: "Pressure",
+  prefilter_dp_pa: "Prefilter dP",
+  prefilter_load_pct: "Prefilter load",
+  prefilter_days_left: "Prefilter life",
+  hood_face_velocity_fpm: "Face velocity",
+  hood_laminar_ok: "Laminar flow",
+  soc_temp_c: "SoC temperature",
+  arm_clock_mhz: "ARM clock",
+  core_volts: "Core volts",
+  undervoltage_now: "Undervoltage",
+  throttled_now: "Throttled",
+};
+
+const TILE_METRICS = ["temperature_c", "humidity_pct", "co2_ppm", "vpd_kpa"] as const;
+const CHART_METRICS = ["temperature_c", "humidity_pct", "co2_ppm"] as const;
+const HOOD_METRICS = ["hood_face_velocity_fpm", "prefilter_load_pct", "prefilter_days_left", "prefilter_dp_pa"] as const;
+const PI_METRICS = ["soc_temp_c", "arm_clock_mhz", "core_volts"] as const;
+
+type Status = "ok" | "down" | "unpaired" | "pending";
+
+function label(metric: string): string {
+  return LABELS[metric] ?? metric.replace(/_/g, " ");
+}
+
+function fmt(v: number): string {
+  if (!Number.isFinite(v)) return "n/a";
+  return Math.abs(v) >= 100 ? Math.round(v).toLocaleString() : v.toFixed(2);
+}
+
+function ago(seconds: number): string {
+  if (!Number.isFinite(seconds) || seconds < 0) return "now";
+  if (seconds < 90) return `${Math.round(seconds)} s ago`;
+  if (seconds < 5400) return `${Math.round(seconds / 60)} min ago`;
+  return `${(seconds / 3600).toFixed(1)} h ago`;
+}
+
+function scoreBand(v: number): "good" | "fair" | "poor" {
+  return v >= 75 ? "good" : v >= 50 ? "fair" : "poor";
+}
+
+/** Zones that carry grow-room readings: not derived, not the hood, not the controller. */
+function growZones(snapshot: SenseData["snapshot"]): string[] {
+  return Object.keys(snapshot)
+    .filter((z) => !z.endsWith("-derived") && z !== "pi" && !z.startsWith("hood"))
+    .sort();
+}
+
+function hoodZones(snapshot: SenseData["snapshot"]): string[] {
+  return Object.keys(snapshot)
+    .filter((z) => z.startsWith("hood") && !z.endsWith("-derived"))
+    .sort();
+}
+
+function freshestAge(snapshot: SenseData["snapshot"], zones: string[]): number | null {
+  let best: number | null = null;
+  for (const z of zones) {
+    for (const e of Object.values(snapshot[z] ?? {})) {
+      if (best === null || e.age < best) best = e.age;
+    }
+  }
+  return best;
+}
+
+/* ------------------------------------------------------------------ *
+ *  Pieces
+ * ------------------------------------------------------------------ */
+
+function Tile({ metric, entry }: { metric: string; entry: SnapshotEntry }) {
+  return (
+    <div className="cx-sense-tile" data-metric={metric}>
+      <span className="cx-sense-k">{label(metric)}</span>
+      <span className="cx-sense-v">
+        {fmt(entry.value)}
+        <span className="cx-sense-u">{entry.unit}</span>
+      </span>
+      {entry.quality && entry.quality !== "ok" && (
+        <span className="cx-sense-q" data-quality={entry.quality}>
+          {entry.quality}
+        </span>
+      )}
+    </div>
+  );
+}
+
+function ScoreTile({ entry }: { entry: SnapshotEntry }) {
+  const band = scoreBand(entry.value);
+  return (
+    <div className="cx-sense-tile" data-metric="fruiting_score">
+      <span className="cx-sense-k">Fruiting score</span>
+      <span className="cx-sense-score" data-band={band}>
+        {fmt(entry.value)}
+      </span>
+      <span className="cx-sense-q" data-quality="est">
+        derived
+      </span>
+    </div>
+  );
+}
+
+function FlagTile({ metric, entry, goodWhenOn }: { metric: string; entry: SnapshotEntry; goodWhenOn: boolean }) {
+  const on = entry.value >= 0.5;
+  const good = goodWhenOn ? on : !on;
+  return (
+    <div className="cx-sense-tile" data-metric={metric}>
+      <span className="cx-sense-k">{label(metric)}</span>
+      <span className="cx-sense-flag" data-good={good ? "yes" : "no"}>
+        {on ? "yes" : "no"}
+      </span>
+    </div>
+  );
+}
+
+const SPARK_W = 240;
+const SPARK_H = 56;
+
+export function Sparkline({ points, unit, title }: { points?: [number, number][]; unit: string; title: string }) {
+  const geometry = useMemo(() => {
+    if (!points || points.length < 2) return null;
+    const xs = points.map((p) => p[0]);
+    const ys = points.map((p) => p[1]);
+    const x0 = xs[0];
+    const x1 = xs[xs.length - 1];
+    let lo = Math.min(...ys);
+    let hi = Math.max(...ys);
+    if (hi - lo < 1e-6) {
+      hi += 1;
+      lo -= 1;
+    }
+    const pad = (hi - lo) * 0.12;
+    lo -= pad;
+    hi += pad;
+    const L = 3;
+    const T = 4;
+    const sx = (v: number) => L + ((v - x0) / (x1 - x0 || 1)) * (SPARK_W - 2 * L);
+    const sy = (v: number) => T + (1 - (v - lo) / (hi - lo)) * (SPARK_H - 2 * T);
+    const d = points.map((p, i) => `${i ? "L" : "M"}${sx(p[0]).toFixed(1)} ${sy(p[1]).toFixed(1)}`).join(" ");
+    const area = `${d} L${sx(x1).toFixed(1)} ${SPARK_H - T} L${sx(x0).toFixed(1)} ${SPARK_H - T} Z`;
+    const last = ys[ys.length - 1];
+    return {
+      d,
+      area,
+      lastX: sx(x1),
+      lastY: sy(last),
+      min: Math.min(...ys),
+      max: Math.max(...ys),
+    };
+  }, [points]);
+
+  return (
+    <div className="cx-sense-chart">
+      <span className="cx-sense-k">{title}</span>
+      {geometry ? (
+        <>
+          <svg
+            className="cx-sense-spark"
+            viewBox={`0 0 ${SPARK_W} ${SPARK_H}`}
+            preserveAspectRatio="none"
+            role="img"
+            aria-label={`${title}, ${fmt(geometry.min)} to ${fmt(geometry.max)} ${unit} over the window`}
+          >
+            <path className="cx-sense-spark-area" d={geometry.area} />
+            <path className="cx-sense-spark-line" d={geometry.d} />
+            <circle className="cx-sense-spark-dot" cx={geometry.lastX.toFixed(1)} cy={geometry.lastY.toFixed(1)} r="2.2" />
+          </svg>
+          <span className="cx-sense-chart-range">
+            {fmt(geometry.min)} to {fmt(geometry.max)} {unit}
+          </span>
+        </>
+      ) : (
+        <span className="cx-sense-chart-range">no series in this window</span>
+      )}
+    </div>
+  );
+}
+
+function ZoneSection({ zone, data }: { zone: string; data: SenseData }) {
+  const s = data.snapshot[zone] ?? {};
+  const derived = data.snapshot[`${zone}-derived`] ?? {};
+  const extras: ReactElement[] = [];
+  if (derived.fruiting_score) extras.push(<ScoreTile key="score" entry={derived.fruiting_score} />);
+  if (derived.dew_point_c) extras.push(<Tile key="dew" metric="dew_point_c" entry={derived.dew_point_c} />);
+  if (s.dew_point_c && !derived.dew_point_c) extras.push(<Tile key="dew2" metric="dew_point_c" entry={s.dew_point_c} />);
+  if (derived.co2_trend_ppm_min) extras.push(<Tile key="trend" metric="co2_trend_ppm_min" entry={derived.co2_trend_ppm_min} />);
+  if (s.light_lux) extras.push(<Tile key="lux" metric="light_lux" entry={s.light_lux} />);
+
+  return (
+    <section className="cx-sense-section" aria-label={zone}>
+      <h3 className="cx-sense-title">{zone.replace(/-/g, " ")}</h3>
+      <div className="cx-sense-tiles">
+        {TILE_METRICS.map((m) => {
+          const e = s[m] ?? (m === "vpd_kpa" ? derived.vpd_kpa : undefined);
+          return e ? <Tile key={m} metric={m} entry={e} /> : null;
+        })}
+        {extras}
+      </div>
+      <div className="cx-sense-charts">
+        {CHART_METRICS.map((m) => (
+          <Sparkline
+            key={m}
+            title={`${label(m)}, ${data.hours} h`}
+            unit={s[m]?.unit ?? ""}
+            points={data.series[`${zone}|${m}`]}
+          />
+        ))}
+      </div>
+    </section>
+  );
+}
+
+function HoodSection({ zone, data }: { zone: string; data: SenseData }) {
+  const s = data.snapshot[zone] ?? {};
+  const d = data.snapshot[`${zone}-derived`] ?? {};
+  const tiles = HOOD_METRICS.map((m) => {
+    const e = d[m] ?? s[m];
+    return e ? <Tile key={m} metric={m} entry={e} /> : null;
+  }).filter(Boolean);
+  const laminar = d.hood_laminar_ok ?? s.hood_laminar_ok;
+  if (!tiles.length && !laminar) return null;
+  return (
+    <section className="cx-sense-section" aria-label="Flow hood">
+      <h3 className="cx-sense-title">Flow hood</h3>
+      <div className="cx-sense-tiles">
+        {tiles}
+        {laminar && <FlagTile metric="hood_laminar_ok" entry={laminar} goodWhenOn />}
+      </div>
+    </section>
+  );
+}
+
+function ControllerSection({ data }: { data: SenseData }) {
+  const p = data.snapshot.pi;
+  if (!p) return null;
+  return (
+    <section className="cx-sense-section" aria-label="Controller">
+      <h3 className="cx-sense-title">Controller</h3>
+      <div className="cx-sense-tiles">
+        {PI_METRICS.map((m) => (p[m] ? <Tile key={m} metric={m} entry={p[m]} /> : null))}
+        {p.undervoltage_now && <FlagTile metric="undervoltage_now" entry={p.undervoltage_now} goodWhenOn={false} />}
+        {p.throttled_now && <FlagTile metric="throttled_now" entry={p.throttled_now} goodWhenOn={false} />}
+      </div>
+    </section>
+  );
+}
+
+function Settings({ cfg, onSave }: { cfg: SenseConfig; onSave: (next: SenseConfig, token: string) => void }) {
+  const [draft, setDraft] = useState<SenseConfig>(cfg);
+  const [token, setToken] = useState<string>(() => getSenseToken());
+  useEffect(() => setDraft(cfg), [cfg]);
+
+  return (
+    <form
+      className="cx-sense-settings"
+      aria-label="Crowe Sense source"
+      onSubmit={(e) => {
+        e.preventDefault();
+        onSave(draft, token);
+      }}
+    >
+      <label className="cx-sense-field">
+        <span>Source</span>
+        <select
+          aria-label="Source"
+          value={draft.source}
+          onChange={(e) => setDraft({ ...draft, source: e.target.value as SenseSource })}
+        >
+          <option value="off">off</option>
+          <option value="direct">direct, on my network</option>
+          <option value="cloud">cloud, through the relay</option>
+        </select>
+      </label>
+      {draft.source === "direct" && (
+        <label className="cx-sense-field cx-sense-field-wide">
+          <span>Node address</span>
+          <input
+            aria-label="Node address"
+            type="url"
+            placeholder="http://100.123.229.57:8078"
+            value={draft.url}
+            onChange={(e) => setDraft({ ...draft, url: e.target.value })}
+          />
+        </label>
+      )}
+      {draft.source === "cloud" && (
+        <>
+          <label className="cx-sense-field">
+            <span>Node id</span>
+            <input
+              aria-label="Node id"
+              type="text"
+              placeholder="cs-a1b2c3"
+              value={draft.node}
+              onChange={(e) => setDraft({ ...draft, node: e.target.value })}
+            />
+          </label>
+          <label className="cx-sense-field cx-sense-field-wide">
+            <span>Relay</span>
+            <input
+              aria-label="Relay"
+              type="url"
+              value={draft.relay}
+              onChange={(e) => setDraft({ ...draft, relay: e.target.value })}
+            />
+          </label>
+          <label className="cx-sense-field cx-sense-field-wide">
+            <span>Token, only if not signed in</span>
+            <input
+              aria-label="Token"
+              type="password"
+              autoComplete="off"
+              value={token}
+              onChange={(e) => setToken(e.target.value)}
+            />
+          </label>
+        </>
+      )}
+      <button type="submit" className="cx-sense-save">
+        Save
+      </button>
+    </form>
+  );
+}
+
+/* ------------------------------------------------------------------ *
+ *  The tab
+ * ------------------------------------------------------------------ */
+
+export function SenseTab() {
+  const [cfg, setCfg] = useState<SenseConfig>(() => getSenseConfig());
+  const [data, setData] = useState<SenseData | null>(null);
+  const [error, setError] = useState<{ error: string; detail: string } | null>(null);
+  const [fetchedAt, setFetchedAt] = useState<number | null>(null);
+  const [clock, setClock] = useState<number>(() => Date.now());
+
+  const getToken = useCallback(() => useAuth.getState().accessToken(), []);
+
+  const load = useCallback(async () => {
+    if (cfg.source === "off") return;
+    try {
+      const d = await fetchData(6, { cfg, getToken });
+      setData(d);
+      setError(null);
+      setFetchedAt(Date.now());
+    } catch (e) {
+      setError(describeSenseError(e));
+    }
+  }, [cfg, getToken]);
+
+  useEffect(() => {
+    if (cfg.source === "off") {
+      setData(null);
+      setError(null);
+      return;
+    }
+    let alive = true;
+    const run = () => {
+      if (alive) void load();
+    };
+    run();
+    const poll = setInterval(run, REFRESH_MS);
+    const tick = setInterval(() => {
+      if (alive) setClock(Date.now());
+    }, CLOCK_MS);
+    return () => {
+      alive = false;
+      clearInterval(poll);
+      clearInterval(tick);
+    };
+  }, [cfg, load]);
+
+  const save = useCallback((next: SenseConfig, token: string) => {
+    setSenseToken(token);
+    setData(null);
+    setError(null);
+    setCfg(setSenseConfig(next));
+  }, []);
+
+  const zones = data ? growZones(data.snapshot) : [];
+  const hoods = data ? hoodZones(data.snapshot) : [];
+  const freshest = data ? freshestAge(data.snapshot, [...zones, ...hoods, "pi"]) : null;
+  const status: Status =
+    cfg.source === "off" ? "unpaired" : error ? "down" : !data ? "pending" : freshest !== null && freshest <= STALE_S ? "ok" : "down";
+  const statusText = { ok: "live", down: "no fresh readings", unpaired: "unpaired", pending: "reading" }[status];
+  const updated = fetchedAt ? ago((clock - fetchedAt) / 1000) : null;
+
+  return (
+    <div className="cortex-projects-wrap cx-sense" data-status={status}>
+      <header className="cx-sense-head">
+        <span className="cx-sense-dot" data-status={status} aria-hidden="true" />
+        <h2 className="cx-sense-h">Sense</h2>
+        <span className="cx-sense-meta" role="status" aria-label={`node status ${statusText}`}>
+          {data ? (
+            <>
+              <b>{data.node}</b>
+              {zones.length > 0 && <span> {zones.join(", ")}</span>}
+              <span> {data.count.toLocaleString()} readings</span>
+              {updated && <span> updated {updated}</span>}
+              <span className="cx-sense-status">{statusText}</span>
+            </>
+          ) : (
+            <span className="cx-sense-status">{statusText}</span>
+          )}
+        </span>
+      </header>
+
+      <Settings cfg={cfg} onSave={save} />
+
+      <div className="cortex-projects-section-body cx-sense-body">
+        {cfg.source === "off" && (
+          <EmptyState
+            title="No node paired."
+            hint="Choose direct for a node on your network or cloud for a relay node."
+          />
+        )}
+        {cfg.source !== "off" && error && (
+          <ErrorState
+            title={`Cannot read the node (${error.error}).`}
+            hint={error.detail}
+            action={{ label: "Try again", onClick: () => void load() }}
+          />
+        )}
+        {cfg.source !== "off" && !error && !data && <LoadingState title="Reading the node..." rows={2} />}
+        {cfg.source !== "off" && !error && data && (
+          <>
+            {zones.length === 0 && hoods.length === 0 && !data.snapshot.pi && (
+              <EmptyState title="The node answered with no readings." hint="Its sampler has not written a row yet." />
+            )}
+            {zones.map((z) => (
+              <ZoneSection key={z} zone={z} data={data} />
+            ))}
+            {hoods.map((z) => (
+              <HoodSection key={z} zone={z} data={data} />
+            ))}
+            <ControllerSection data={data} />
+            <p className="cx-sense-foot">
+              Every figure here was read from the node {updated ?? "just now"}. Nothing on this surface is sampled or assumed.
+            </p>
+          </>
+        )}
+      </div>
+    </div>
+  );
+}
